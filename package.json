{
  "name": "dave",
  "version": "0.1.0",
  "description": "UI test suite for halOP (WildFly management console)",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:tag": "vpx scripts/test-tag.ts",
    "report": "playwright show-report",
    "allure:generate": "allure awesome allure-results --output allure-report",
    "allure:serve": "allure serve allure-results",
    "allure:open": "allure open allure-report",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "sync": "vpx scripts/sync-help.ts",
    "sync:identifiers": "vpx scripts/sync-identifiers.ts",
    "sync:ouia": "vpx scripts/sync-ouia.ts",
    "sync:image": "vpx scripts/sync-image.ts",
    "sync:status": "vpx scripts/sync-status.ts",
    "sync:ci": "vpx scripts/sync-ci.ts",
    "sync:help": "vpx scripts/sync-help.ts",
    "test:unit": "vp test run",
    "test:unit:watch": "vp test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "allure": "^3.14.3",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "eslint-plugin-playwright": "^2.11.0",
    "markdownlint-cli2": "^0.23.2",
    "mermaid": "^11.16.1",
    "testcontainers": "^12.1.0",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.23.0"
}
